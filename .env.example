# LOCAL DEVELOPMENT ONLY.
#
# The deployed site does NOT read this file. Vite compiles VITE_* values into
# the bundle at build time, so once the site is transferred to a host with no
# build step they can never be changed. The real configuration lives in the
# SITE CONFIGURATION block at the top of index.html and is read at runtime.
# See DEPLOY.md.
#
# These are used only when that block still contains its __PLACEHOLDER__ values,
# which is the normal state while developing locally.

VITE_CRM_LEAD_WEBHOOK=
VITE_CRM_BOOKING_URL=

VITE_GA4_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_QUOTE_LABEL=
VITE_GOOGLE_ADS_BOOKING_LABEL=
VITE_META_PIXEL_ID=
