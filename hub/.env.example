# Copy to .env.local to change. Build-time settings, no secrets here.

# 'live' (the default in the code): data comes from the Hub proxy and the staff app needs a signed link. 'mock': data lives in this browser.
# Set it explicitly on a host (Vercel: VITE_DATA_SOURCE=live).
VITE_DATA_SOURCE=mock

# Base address of the Hub proxy. Leave empty for same origin (the app and /api served together).
VITE_PROXY_URL=
